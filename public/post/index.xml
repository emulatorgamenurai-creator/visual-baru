    <item>
      <title>Daftar Link Resmi Indramayu Club Global</title>
      <link>http://localhost:1313/post/media_global/</link>
      <pubDate>Thu, 21 May 2026 00:00:00 +0000</pubDate>
      <guid>http://localhost:1313/post/media_global/</guid>
      <description>&lt;!DOCTYPE html&gt;&#xA;&lt;html lang=&#34;id&#34;&gt;&#xA;&lt;head&gt;&#xA;&lt;meta charset=&#34;UTF-8&#34;&gt;&#xA;&lt;meta name=&#34;viewport&#34; content=&#34;width=device-width, initial-scale=1.0&#34;&gt;&#xA;&lt;title&gt;Kalkulator – Pasar Indramayu Club Makrifat&lt;/title&gt;&#xA;&lt;link href=&#34;https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&amp;family=Plus+Jakarta+Sans:ital,wght@0,400;0,600;1,400&amp;display=swap&#34; rel=&#34;stylesheet&#34;&gt;&#xA;&lt;style&gt;&#xA;  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }&#xA;&#xA;  :root {&#xA;    --bg-dark:    #030914;&#xA;    --panel-bg:   rgba(10, 25, 47, 0.75);&#xA;    --cyan-glow:  #00f0ff;&#xA;    --blue-bright:#38b6ff;&#xA;    --text-light: #e2f1ff;&#xA;    --btn-num:    rgba(20, 40, 80, 0.5);&#xA;    --btn-op:     rgba(0, 180, 216, 0.3);&#xA;    --btn-eq:     linear-gradient(135deg, #00b4d8 0%, #00f0ff 100%);&#xA;    --shadow-rgb: 0, 240, 255;&#xA;  }&#xA;&#xA;  body {&#xA;    min-height: 100vh;&#xA;    background: var(--bg-dark);&#xA;    display: flex;&#xA;    flex-direction: column;&#xA;    align-items: center;&#xA;    justify-content: center;&#xA;    font-family: &#39;Plus Jakarta Sans&#39;, sans-serif;&#xA;    padding: 20px;&#xA;    overflow: hidden;&#xA;    position: relative;&#xA;  }&#xA;&#xA;   &#xA;  body::before {&#xA;    content: &#39;&#39;;&#xA;    position: fixed; inset: 0;&#xA;    background-image: &#xA;      linear-gradient(rgba(0, 240, 255, 0.03) 1px, transparent 1px),&#xA;      linear-gradient(90deg, rgba(0, 240, 255, 0.03) 1px, transparent 1px);&#xA;    background-size: 30px 30px;&#xA;    pointer-events: none;&#xA;  }&#xA;&#xA;  body::after {&#xA;    content: &#39;&#39;;&#xA;    position: fixed; inset: 0;&#xA;    background: radial-gradient(circle at 50% 50%, rgba(56, 182, 255, 0.15) 0%, transparent 70%);&#xA;    pointer-events: none;&#xA;  }&#xA;&#xA;  .wrapper {&#xA;    position: relative;&#xA;    z-index: 1;&#xA;    width: 100%;&#xA;    max-width: 380px;&#xA;  }&#xA;&#xA;   &#xA;  .header {&#xA;    text-align: center;&#xA;    margin-bottom: 20px;&#xA;    animation: fadeDown 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;&#xA;  }&#xA;&#xA;  .header .ornament {&#xA;    color: var(--cyan-glow);&#xA;    font-size: 1.2rem;&#xA;    letter-spacing: 6px;&#xA;    text-shadow: 0 0 10px var(--cyan-glow);&#xA;    opacity: 0.8;&#xA;  }&#xA;&#xA;  .header h1 {&#xA;    font-family: &#39;Orbitron&#39;, sans-serif;&#xA;    font-size: 1.25rem;&#xA;    font-weight: 700;&#xA;    color: #ffffff;&#xA;    text-shadow: 0 0 15px rgba(0, 240, 255, 0.6);&#xA;    letter-spacing: 1px;&#xA;    line-height: 1.4;&#xA;    margin: 6px 0;&#xA;  }&#xA;&#xA;  .header .sub {&#xA;    font-size: 0.8rem;&#xA;    color: var(--blue-bright);&#xA;    font-weight: 500;&#xA;    letter-spacing: 3px;&#xA;    text-transform: uppercase;&#xA;  }&#xA;&#xA;   &#xA;  .calc {&#xA;    background: var(--panel-bg);&#xA;    backdrop-filter: blur(12px);&#xA;    -webkit-backdrop-filter: blur(12px);&#xA;    border: 2px solid rgba(0, 240, 255, 0.3);&#xA;    border-radius: 24px;&#xA;    padding: 24px 20px 20px;&#xA;    box-shadow:&#xA;      0 0 30px rgba(0, 240, 255, 0.1),&#xA;      0 20px 50px rgba(0,0,0,0.5),&#xA;      inset 0 1px 2px rgba(255,255,255,0.1);&#xA;    animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) both 0.1s;&#xA;    position: relative;&#xA;  }&#xA;&#xA;   &#xA;  .calc::before {&#xA;    content: &#39;&#39;;&#xA;    position: absolute;&#xA;    top: -2px; left: 20%; right: 20%;&#xA;    height: 2px;&#xA;    background: linear-gradient(90deg, transparent, var(--cyan-glow), transparent);&#xA;    box-shadow: 0 0 10px var(--cyan-glow);&#xA;  }&#xA;&#xA;   &#xA;  .corner {&#xA;    position: absolute;&#xA;    width: 12px; height: 12px;&#xA;    border-color: var(--cyan-glow);&#xA;    border-style: solid;&#xA;    opacity: 0.8;&#xA;  }&#xA;  .corner.tl { top: 12px; left: 12px; border-width: 2px 0 0 2px; }&#xA;  .corner.tr { top: 12px; right: 12px; border-width: 2px 2px 0 0; }&#xA;  .corner.bl { bottom: 12px; left: 12px; border-width: 0 0 2px 2px; }&#xA;  .corner.br { bottom: 12px; right: 12px; border-width: 0 2px 2px 0; }&#xA;&#xA;   &#xA;  .display {&#xA;    background: rgba(5, 12, 28, 0.85);&#xA;    border: 1.5px solid rgba(0, 240, 255, 0.2);&#xA;    border-radius: 14px;&#xA;    padding: 16px 18px 12px;&#xA;    margin-bottom: 20px;&#xA;    min-height: 95px;&#xA;    display: flex;&#xA;    flex-direction: column;&#xA;    justify-content: flex-end;&#xA;    align-items: flex-end;&#xA;    box-shadow: inset 0 2px 8px rgba(0,0,0,0.8);&#xA;    position: relative;&#xA;  }&#xA;&#xA;  .display::before {&#xA;    content: &#39;⚡ MAKRIFAT DIGITAL ⚡&#39;;&#xA;    position: absolute;&#xA;    top: 8px; left: 18px;&#xA;    font-size: 0.55rem;&#xA;    font-family: &#39;Orbitron&#39;, sans-serif;&#xA;    letter-spacing: 2px;&#xA;    color: rgba(0, 240, 255, 0.4);&#xA;  }&#xA;&#xA;  .display .expr {&#xA;    font-family: &#39;Orbitron&#39;, sans-serif;&#xA;    font-size: 0.8rem;&#xA;    color: rgba(56, 182, 255, 0.6);&#xA;    min-height: 20px;&#xA;    word-break: break-all;&#xA;    text-align: right;&#xA;  }&#xA;&#xA;  .display .result {&#xA;    font-family: &#39;Orbitron&#39;, sans-serif;&#xA;    font-size: 2.3rem;&#xA;    font-weight: 500;&#xA;    color: #ffffff;&#xA;    text-shadow: 0 0 12px rgba(0, 240, 255, 0.5);&#xA;    word-break: break-all;&#xA;    text-align: right;&#xA;    line-height: 1.2;&#xA;    transition: all 0.15s;&#xA;  }&#xA;&#xA;  .display .result.big { font-size: 1.8rem; }&#xA;  .display .result.bigger { font-size: 1.3rem; }&#xA;&#xA;   &#xA;  .grid {&#xA;    display: grid;&#xA;    grid-template-columns: repeat(4, 1fr);&#xA;    gap: 10px;&#xA;  }&#xA;&#xA;  button {&#xA;    font-family: &#39;Orbitron&#39;, sans-serif;&#xA;    font-size: 1.15rem;&#xA;    font-weight: 500;&#xA;    border: 1px solid rgba(0, 240, 255, 0.15);&#xA;    border-radius: 12px;&#xA;    cursor: pointer;&#xA;    height: 56px;&#xA;    color: var(--text-light);&#xA;    transition: all 0.15s ease;&#xA;    position: relative;&#xA;    overflow: hidden;&#xA;  }&#xA;&#xA;  button:hover {&#xA;    border-color: rgba(0, 240, 255, 0.5);&#xA;    box-shadow: 0 0 10px rgba(0, 240, 255, 0.15);&#xA;  }&#xA;&#xA;  button:active { transform: scale(0.95); }&#xA;&#xA;   &#xA;  .btn-num {&#xA;    background: var(--btn-num);&#xA;  }&#xA;  .btn-num:hover {&#xA;    background: rgba(30, 60, 110, 0.6);&#xA;    color: #ffffff;&#xA;  }&#xA;&#xA;   &#xA;  .btn-op {&#xA;    background: var(--btn-op);&#xA;    color: var(--cyan-glow);&#xA;    border-color: rgba(0, 240, 255, 0.25);&#xA;  }&#xA;  .btn-op:hover {&#xA;    background: rgba(0, 180, 216, 0.45);&#xA;    text-shadow: 0 0 8px var(--cyan-glow);&#xA;  }&#xA;&#xA;   &#xA;  .btn-sp {&#xA;    background: rgba(15, 32, 67, 0.4);&#xA;    color: var(--blue-bright);&#xA;    font-size: 0.95rem;&#xA;  }&#xA;  .btn-sp:hover {&#xA;    background: rgba(25, 52, 107, 0.6);&#xA;    color: #ffffff;&#xA;  }&#xA;&#xA;   &#xA;  .btn-eq {&#xA;    background: var(--btn-eq);&#xA;    color: var(--bg-dark);&#xA;    font-weight: 700;&#xA;    border: none;&#xA;    box-shadow: 0 0 15px rgba(0, 240, 255, 0.4);&#xA;  }&#xA;  .btn-eq:hover {&#xA;    box-shadow: 0 0 22px rgba(0, 240, 255, 0.7);&#xA;    filter: brightness(1.1);&#xA;  }&#xA;&#xA;  .span2 { grid-column: span 2; }&#xA;&#xA;   &#xA;  .ripple {&#xA;    position: absolute;&#xA;    border-radius: 50%;&#xA;    background: rgba(0, 240, 255, 0.4);&#xA;    transform: scale(0);&#xA;    animation: ripple 0.4s linear;&#xA;    pointer-events: none;&#xA;  }&#xA;  @keyframes ripple { to { transform: scale(4); opacity: 0; } }&#xA;&#xA;   &#xA;  .footer {&#xA;    text-align: center;&#xA;    margin-top: 18px;&#xA;    font-size: 0.7rem;&#xA;    color: rgba(56, 182, 255, 0.4);&#xA;    letter-spacing: 2px;&#xA;    text-transform: uppercase;&#xA;    font-family: &#39;Orbitron&#39;, sans-serif;&#xA;    animation: fadeUp 0.8s ease both 0.3s;&#xA;  }&#xA;&#xA;  @keyframes fadeDown { from { opacity:0; transform:translateY(-15px); } to { opacity:1; transform:none; } }&#xA;  @keyframes fadeUp   { from { opacity:0; transform:translateY(15px);  } to { opacity:1; transform:none; } }&#xA;&#xA;  .pulse { animation: pulse 0.15s ease-out; }&#xA;  @keyframes pulse { 0% { transform: scale(1); } 50% { transform: scale(1.02); } 100% { transform: scale(1); } }&#xA;&lt;/style&gt;&#xA;&lt;/head&gt;&#xA;&lt;body&gt;&#xA;&#xA;&lt;div class=&#34;wrapper&#34;&gt;&#xA;  &lt;div class=&#34;header&#34;&gt;&#xA;    &lt;div class=&#34;ornament&#34;&gt;⚡ 🌐 ⚡&lt;/div&gt;&#xA;    &lt;h1&gt;Pasar Indramayu&lt;br&gt;Club Makrifat&lt;/h1&gt;&#xA;    &lt;div class=&#34;sub&#34;&gt;Kalkulator Berkah&lt;/div&gt;&#xA;  &lt;/div&gt;&#xA;&#xA;  &lt;div class=&#34;calc&#34;&gt;&#xA;    &lt;div class=&#34;corner tl&#34;&gt;&lt;/div&gt;&#xA;    &lt;div class=&#34;corner tr&#34;&gt;&lt;/div&gt;&#xA;    &lt;div class=&#34;corner bl&#34;&gt;&lt;/div&gt;&#xA;    &lt;div class=&#34;corner br&#34;&gt;&lt;/div&gt;&#xA;&#xA;    &lt;div class=&#34;display&#34;&gt;&#xA;      &lt;div class=&#34;expr&#34; id=&#34;expr&#34;&gt;&lt;/div&gt;&#xA;      &lt;div class=&#34;result&#34; id=&#34;result&#34;&gt;0&lt;/div&gt;&#xA;    &lt;/div&gt;&#xA;&#xA;    &lt;div class=&#34;grid&#34;&gt;&#xA;      &lt;button class=&#34;btn-sp&#34; onclick=&#34;clearAll()&#34;&gt;AC&lt;/button&gt;&#xA;      &lt;button class=&#34;btn-sp&#34; onclick=&#34;toggleSign()&#34;&gt;+/-&lt;/button&gt;&#xA;      &lt;button class=&#34;btn-sp&#34; onclick=&#34;percent()&#34;&gt;%&lt;/button&gt;&#xA;      &lt;button class=&#34;btn-op&#34; onclick=&#34;setOp(&#39;÷&#39;)&#34;&gt;÷&lt;/button&gt;&#xA;&#xA;      &lt;button class=&#34;btn-num&#34; onclick=&#34;num(&#39;7&#39;)&#34;&gt;7&lt;/button&gt;&#xA;      &lt;button class=&#34;btn-num&#34; onclick=&#34;num(&#39;8&#39;)&#34;&gt;8&lt;/button&gt;&#xA;      &lt;button class=&#34;btn-num&#34; onclick=&#34;num(&#39;9&#39;)&#34;&gt;9&lt;/button&gt;&#xA;      &lt;button class=&#34;btn-op&#34; onclick=&#34;setOp(&#39;×&#39;)&#34;&gt;×&lt;/button&gt;&#xA;&#xA;      &lt;button class=&#34;btn-num&#34; onclick=&#34;num(&#39;4&#39;)&#34;&gt;4&lt;/button&gt;&#xA;      &lt;button class=&#34;btn-num&#34; onclick=&#34;num(&#39;5&#39;)&#34;&gt;5&lt;/button&gt;&#xA;      &lt;button class=&#34;btn-num&#34; onclick=&#34;num(&#39;6&#39;)&#34;&gt;6&lt;/button&gt;&#xA;      &lt;button class=&#34;btn-op&#34; onclick=&#34;setOp(&#39;−&#39;)&#34;&gt;−&lt;/button&gt;&#xA;&#xA;      &lt;button class=&#34;btn-num&#34; onclick=&#34;num(&#39;1&#39;)&#34;&gt;1&lt;/button&gt;&#xA;      &lt;button class=&#34;btn-num&#34; onclick=&#34;num(&#39;2&#39;)&#34;&gt;2&lt;/button&gt;&#xA;      &lt;button class=&#34;btn-num&#34; onclick=&#34;num(&#39;3&#39;)&#34;&gt;3&lt;/button&gt;&#xA;      &lt;button class=&#34;btn-op&#34; onclick=&#34;setOp(&#39;+&#39;)&#34;&gt;+&lt;/button&gt;&#xA;&#xA;      &lt;button class=&#34;btn-num span2&#34; onclick=&#34;num(&#39;0&#39;)&#34;&gt;0&lt;/button&gt;&#xA;      &lt;button class=&#34;btn-num&#34; onclick=&#34;dot()&#34;&gt;.&lt;/button&gt;&#xA;      &lt;button class=&#34;btn-eq&#34; onclick=&#34;calc()&#34;&gt;=&lt;/button&gt;&#xA;    &lt;/div&gt;&#xA;  &lt;/div&gt;&#xA;&#xA;  &lt;div class=&#34;footer&#34;&gt;✦ Global Blessing System ✦&lt;/div&gt;&#xA;&lt;/div&gt;&#xA;&#xA;&lt;script&gt;&#xA;  let cur = &#39;0&#39;, prev = &#39;&#39;, op = &#39;&#39;, shouldReset = false;&#xA;&#xA;  const disp  = document.getElementById(&#39;result&#39;);&#xA;  const expr  = document.getElementById(&#39;expr&#39;);&#xA;&#xA;  function updateDisplay(val) {&#xA;    disp.textContent = format(val);&#xA;    const len = String(format(val)).length;&#xA;    disp.className = &#39;result&#39; + (len &gt; 12 ? &#39; bigger&#39; : len &gt; 8 ? &#39; big&#39; : &#39;&#39;);&#xA;    disp.classList.add(&#39;pulse&#39;);&#xA;    setTimeout(() =&gt; disp.classList.remove(&#39;pulse&#39;), 150);&#xA;  }&#xA;&#xA;  function format(n) {&#xA;    if (n === &#39;Error&#39;) return &#39;Error&#39;;&#xA;    const s = String(n);&#xA;    if (s.endsWith(&#39;.&#39;) || (s.includes(&#39;.&#39;) &amp;&amp; s.endsWith(&#39;0&#39;))) return s;&#xA;    const num = parseFloat(n);&#xA;    if (isNaN(num)) return s;&#xA;    if (Math.abs(num) &gt;= 1e15) return num.toExponential(4);&#xA;    return num.toLocaleString(&#39;id-ID&#39;, { maximumFractionDigits: 10 });&#xA;  }&#xA;&#xA;  function num(d) {&#xA;    rippleBtn(event);&#xA;    if (shouldReset) { cur = d === &#39;.&#39; ? &#39;0&#39; : d; shouldReset = false; }&#xA;    else if (cur === &#39;0&#39; &amp;&amp; d !== &#39;.&#39;) cur = d;&#xA;    else if (cur.length &lt; 18) cur += d;&#xA;    updateDisplay(cur);&#xA;  }&#xA;&#xA;  function dot() {&#xA;    rippleBtn(event);&#xA;    if (shouldReset) { cur = &#39;0.&#39;; shouldReset = false; }&#xA;    else if (!cur.includes(&#39;.&#39;)) cur += &#39;.&#39;;&#xA;    updateDisplay(cur);&#xA;  }&#xA;&#xA;  function setOp(o) {&#xA;    rippleBtn(event);&#xA;    if (op &amp;&amp; !shouldReset) calculate();&#xA;    prev = cur; op = o; shouldReset = true;&#xA;    expr.textContent = format(prev) + &#39; &#39; + o;&#xA;  }&#xA;&#xA;  function calculate() {&#xA;    if (!op || !prev) return;&#xA;    const a = parseFloat(prev), b = parseFloat(cur);&#xA;    let res;&#xA;    if (op === &#39;+&#39;)  res = a + b;&#xA;    if (op === &#39;−&#39;)  res = a - b;&#xA;    if (op === &#39;×&#39;)  res = a * b;&#xA;    if (op === &#39;÷&#39;)  res = b === 0 ? &#39;Error&#39; : a / b;&#xA;    expr.textContent = format(prev) + &#39; &#39; + op + &#39; &#39; + format(cur) + &#39; =&#39;;&#xA;    cur = res === &#39;Error&#39; ? &#39;Error&#39; : String(+res.toFixed(10));&#xA;    op = &#39;&#39;; prev = &#39;&#39;; shouldReset = true;&#xA;    updateDisplay(cur);&#xA;  }&#xA;&#xA;  function calc() {&#xA;    rippleBtn(event);&#xA;    calculate();&#xA;  }&#xA;&#xA;  function clearAll() {&#xA;    rippleBtn(event);&#xA;    cur = &#39;0&#39;; prev = &#39;&#39;; op = &#39;&#39;; shouldReset = false;&#xA;    expr.textContent = &#39;&#39;;&#xA;    updateDisplay(&#39;0&#39;);&#xA;  }&#xA;&#xA;  function toggleSign() {&#xA;    rippleBtn(event);&#xA;    if (cur === &#39;0&#39; || cur === &#39;Error&#39;) return;&#xA;    cur = String(-parseFloat(cur));&#xA;    updateDisplay(cur);&#xA;  }&#xA;&#xA;  function percent() {&#xA;    rippleBtn(event);&#xA;    if (cur === &#39;Error&#39;) return;&#xA;    cur = String(parseFloat(cur) / 100);&#xA;    updateDisplay(cur);&#xA;  }&#xA;&#xA;  function rippleBtn(e) {&#xA;    if (!e || !e.currentTarget) return;&#xA;    const btn = e.currentTarget;&#xA;    const r = document.createElement(&#39;span&#39;);&#xA;    r.className = &#39;ripple&#39;;&#xA;    const rect = btn.getBoundingClientRect();&#xA;    const size = Math.max(rect.width, rect.height);&#xA;    r.style.cssText = `width:${size}px;height:${size}px;left:${(rect.width-size)/2}px;top:${(rect.height-size)/2}px`;&#xA;    btn.appendChild(r);&#xA;    setTimeout(() =&gt; r.remove(), 400);&#xA;  }&#xA;&#xA;  &#xA;  document.addEventListener(&#39;keydown&#39;, e =&gt; {&#xA;    const k = e.key;&#xA;    if (&#39;0123456789&#39;.includes(k))      { num(k); }&#xA;    else if (k === &#39;.&#39;)                { dot(); }&#xA;    else if (k === &#39;+&#39;)                { setOp(&#39;+&#39;); }&#xA;    else if (k === &#39;-&#39;)                { setOp(&#39;−&#39;); }&#xA;    else if (k === &#39;*&#39;)                { setOp(&#39;×&#39;); }&#xA;    else if (k === &#39;/&#39;)                { e.preventDefault(); setOp(&#39;÷&#39;); }&#xA;    else if (k === &#39;Enter&#39; || k === &#39;=&#39;) { calc(); }&#xA;    else if (k === &#39;Backspace&#39;)        { if (!shouldReset &amp;&amp; cur.length &gt; 1) cur = cur.slice(0,-1); else cur = &#39;0&#39;; updateDisplay(cur); }&#xA;    else if (k === &#39;Escape&#39;)           { clearAll(); }&#xA;    else if (k === &#39;%&#39;)                { percent(); }&#xA;  });&#xA;&lt;/script&gt;&#xA;&lt;/body&gt;&#xA;&lt;/html&gt;&#xA;&#xA;&#xA;&#xA;&lt;div style=&#34;font-family: &#39;Segoe UI&#39;, Arial, sans-serif; padding: 20px; background: #ffffff; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); border-top: 4px solid #0056b3;&#34;&gt;&#xA;    &lt;h2 style=&#34;color: #0056b3; margin-top: 0; padding-bottom: 8px; border-bottom: 2px solid #f0f0f0;&#34;&gt;PORTAL MEDIA GLOBAL&lt;/h2&gt;&#xA;    &lt;p style=&#34;color: #666; font-size: 13px; font-style: italic;&#34;&gt;Sistem Sinkronisasi Otomatis Master Nur Lokal&lt;/p&gt;</description>
    </item>
